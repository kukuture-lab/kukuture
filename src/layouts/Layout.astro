---
interface Props {
  title: string;
  dark?: boolean;
}

const { title, dark = false } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={dark ? "dark-theme" : ""}>
    <!-- 画面の端まで広がるヘッダー（背景色をつける場所） -->
    <header class="header">
      <div class="header-inner">
        <div class="logo">
          <a href="/">くくつれ</a>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/artworks">Artworks</a>
          <a href="/achievements">Achievements</a>
        </nav>
      </div>
    </header>

    <!-- メインコンテンツ（全幅対応：バナーなどを画面全体に広げられる） -->
    <main>
      <slot />
    </main>

    <!-- フッター -->
    <footer>
      <div class="container">
        <p>© 2026 くくつれ</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* 基本のリセット */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Zen Kaku Gothic New", sans-serif;
    line-height: 1.8;
    color: #333;
    background-color: #f4f6f8; /* ページ全体の背景色（薄いグレー） */
    min-height: 100vh;
    transition: background-color 0.2s ease;
  }

  /* 実績ページなどのダークテーマ用 */
  body.dark-theme {
    background-color: #0b0d14; /* 画面全体の黒背景 */
    color: #f0f4fc;
  }

  body.dark-theme .header {
    border-bottom: 1px solid #1a202c;
  }

  /* ===================================================
	   ヘッダー（上側だけ色を変える部分）
	   =================================================== */
  .header {
    width: 100%;
    background-color: #000000; /* ★ここを変えるとヘッダーの色が変わります！ */
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);

    /* スクロールしても上部に固定する設定 */
    position: sticky;
    top: 0;
    z-index: 1000; /* コンテンツや画像より一番手前に表示する */
  }

  /* ヘッダーの中身（中央揃え・最大幅） */
  .header-inner {
    max-width: 970px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 1px;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    color: #d1d1d1;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #e60012; /* UUUM風のアクセントカラー（赤） */
  }

  /* ===================================================
	   メイン領域と共通コンテナ設定
	   =================================================== */
  main {
    width: 100%;
  }

  /* 各ページで使える共通の中央寄せクラス */
  :global(.container) {
    max-width: 970px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  footer {
    margin-top: 3rem;
    padding: 2rem 0;
    font-size: 0.85rem;
    color: #888;
    text-align: center;
  }
</style>
